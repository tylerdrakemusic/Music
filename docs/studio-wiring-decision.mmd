    JBL_L["JBL 2600 (L)\nPassive PA Speaker\n300W / 8Ω\nSpring-clip input"]
    JBL_R["JBL 2600 (R)\nPassive PA Speaker\n300W / 8Ω\nSpring-clip input"]

    Sterling["Sterling Center Speaker\nPassive\nStandard speaker wire\nBinding posts"]

    Guitar -->|"1/4&quot; TS → Hi-Z"| Interface
