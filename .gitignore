# FR-20260423-sibling-gitignore-parity
*.pyo
*.pyd
.playwright-mcp/
src/data/*.db
src/data/*.db-journal
src/data/*.db-wal
src/data/*.db-shm
src/data/backups/
*.tmp
.venv/

# FR-20260425-guitar-trainer-data-to-db
# Exercise definitions and training logs are runtime data (user-modified during
# practice sessions). They live on disk but must not pollute git state.
tools/tyJson/exercises/musicTraining/

# Generated dashboards (auto-regenerated with date stamps on each run)
reports/band_management_panel.html

# Proof / QA screenshots (ephemeral QA artifacts — not committed to git)
proof/FR-20260809-guitar-trainer-wav-count-in/
proof/**/*.png
proof/**/*.jpg
proof/**/*.jpeg
proof/**/*.webp
proof/**/*.gif
proof/**/*.html

# scratch/debug tools
tools/_*.py

# temp directory
tmp/

# Google Drive downloaded sheet music binary assets (pdf/jpg/png scans, regenerated
# by gdrive_client) — ephemeral, not tracked. Generated .docx chord sheet
# deliverables (FR-20260703-music-agentic-chord-sheets) ARE tracked.
catalog/sheet_music/**/*.pdf
catalog/sheet_music/**/*.jpg
catalog/sheet_music/**/*.jpeg
catalog/sheet_music/**/*.png
catalog/sheet_music/_process_logs/
catalog/sheet_music/**/.~lock.*#

# Workspace-local git worktrees (FR-20260511-worktree-local-migration)
.worktrees/

# Workspace-local git worktrees
.worktrees/

# Workspace-local git worktrees
.worktrees/
Brand/hyperthreat/*.b64.txt
